# Governance Gateway (PEP) -- holds NO upstream credentials, only consumer keys.

# One key per consumer: GOVERNANCE_KEY_<NAME>=<secret>. <NAME> (lowercased)
# becomes the consumer identity and maps to entitlements in
# governance_core/policy/entitlements.py (chatbot / email_bot / analytics / ...).
GOVERNANCE_KEY_CHATBOT=dev-chatbot-key
GOVERNANCE_KEY_EMAIL_BOT=dev-email-key
GOVERNANCE_KEY_ANALYTICS=dev-analytics-key

# Optional per-consumer hourly rate limit (defaults to GOVERNANCE_DEFAULT_RATE_LIMIT_PER_HOUR).
# GOVERNANCE_RATE_LIMIT_CHATBOT=1000
GOVERNANCE_DEFAULT_RATE_LIMIT_PER_HOUR=1000

# Backend MCP endpoints (the gateway is an MCP client to these).
MINIERP_MCP_URL=http://localhost:8021/mcp
GATEWAY_BACKEND_TIMEOUT_SEC=30

# Local listener port (Azure sets PORT/WEBSITES_PORT in prod).
GATEWAY_PORT=8020

# Hosts allowed by the MCP transport (comma-separated). Set to the gateway's
# App Service hostname in prod. localhost is always allowed for dev.
GATEWAY_ALLOWED_HOSTS=

# Optional Layer 1 controls
# GOVERNANCE_IP_ALLOWLIST=10.0.0.0/8
# GOVERNANCE_MAX_BODY_BYTES=65536

# ── Control-plane persistence (Stage 1) ───────────────────────────────────────
# Writable, persistent policy/user store (register / approve / key survive
# restart). Omit to use the in-memory env-seeded store. On App Service use a
# persistent path, e.g. /home/data/policy.json.
GOVERNANCE_STORE_FILE=./data/policy.json

# Durable audit sink (append-only JSONL). The dashboard "who asked" monitor
# hydrates from this at startup, so it survives restarts. On App Service use a
# persistent path, e.g. /home/data/audit.jsonl. Omit -> in-memory only (resets).
GOVERNANCE_AUDIT_FILE=./data/audit.jsonl

# Generated office/email artifacts plus workflow and approval runtime state.
# These are local filesystem stores for the first expansion stage; point them at
# persistent storage in production, e.g. /home/data/artifacts and /home/data/state.
GOVERNANCE_ARTIFACT_DIR=./data/artifacts
GOVERNANCE_STATE_DIR=./data/state
# Optional explicit state files if you want to split runtime stores.
# GOVERNANCE_AUTOMATION_STORE_FILE=./data/state/automations.json
# GOVERNANCE_WORKFLOW_STORE_FILE=./data/state/workflow-runs.json
# GOVERNANCE_APPROVAL_STORE_FILE=./data/state/approvals.json
# GOVERNANCE_EMAIL_SEND_STORE_FILE=./data/state/email-sends.json

# Optional ONLYOFFICE handoff for generated artifacts. When set, the artifact
# workbench returns a document-server config for DOCX/XLSX/PPTX preview/edit.
# See ../ONLYOFFICE.md for local Document Server setup.
# ONLYOFFICE_DOCUMENT_SERVER_URL=http://localhost:8080
# ONLYOFFICE_EDIT_MODE=view
# ONLYOFFICE_JWT_SECRET must match the JWT_SECRET Document Server itself is
# configured with -- without it, config signing/callback verification is a
# no-op (fine for local dev, not for anything network-reachable).
# ONLYOFFICE_JWT_SECRET=
# mcp-office's edit_office_document tool talks to Document Server directly (not
# through the gateway's request object), so -- unlike the gateway routes, which
# derive their own base URL from the incoming request -- it needs this spelled
# out explicitly to build URLs Document Server can fetch.
# GATEWAY_PUBLIC_URL=http://localhost:8000

# Email delivery adapter. The local default never sends externally; it records an
# approved send queue item for an Outlook/Gmail/Graph adapter to process later.
EMAIL_DELIVERY_PROVIDER=manual
EMAIL_MOCK_SEND=false
# Comma-separated domains that count as "internal" for the email_send_internal
# category (expansion.md §7.1): a send_email_draft call where EVERY recipient is
# on one of these domains skips the approval gate. Unset (default) = nothing is
# internal, so every send stays approval-gated (email_send_external behavior).
# EMAIL_INTERNAL_DOMAINS=frontierdental.com

# Row-count gate for export-risk tools (create_excel_report, etc. -- see
# ToolPolicy.max_rows_without_approval in policy/manifest.py §7.3). Set this to
# override every export tool's declared default in one place (mainly for
# tests/tuning); leave unset to use each tool's own manifest value.
# GOVERNANCE_BROAD_EXPORT_APPROVAL_ROWS=100

# Off by default: require the blanket "workflow_runner" category (in addition to
# each template's own requiredCategories) before ANY workflow can be run.
# GOVERNANCE_REQUIRE_WORKFLOW_RUNNER_CATEGORY=false

# Kill switch for minierp_finance_get_sales_price (ARSalesPrice), gated at the
# gateway choke point (see gateway/govern.py's _GATED_TOOLS_ENV_FLAGS) ahead of
# a full security review of that data surface -- overrides any category grant.
# false/unset (default) = denied for everyone; true = re-enabled, no code change.
ALLOW_PRICE_QUERY=false

# ── Dashboard login / sessions ────────────────────────────────────────────────
# Required for dashboard login/register (HMAC-signs the session cookie). Set a
# long random value; keep it stable or all sessions invalidate.
GOVERNANCE_SESSION_SECRET=dev-session-secret-change-me
# Seed the first admin (so someone can approve registrations + assign scope):
# GOVERNANCE_ADMIN_USER=admin
# GOVERNANCE_ADMIN_PASSWORD=change-me
# Session cookies default to Secure-only (HTTPS). Local dev over plain
# http://localhost needs this off, or login won't persist across requests.
# GOVERNANCE_COOKIE_SECURE=false

# ── Chat assistant LLM (Stage 1) ──────────────────────────────────────────────
# Self-hosted Qwen3.6-27B via sglang (OpenAI-compatible). The server has no
# tool-call parser, so the orchestrator parses Qwen's <tool_call> text blocks
# client-side -- no server change needed.
GOVERNANCE_CHAT_BASE_URL=http://20.120.220.8:8000/v1
GOVERNANCE_CHAT_MODEL=/home/azureuser/models/Qwen3.6-27B-FP8
GOVERNANCE_CHAT_API_KEY=set-me-from-Qwen3.6_27B/localllm.env
GOVERNANCE_CHAT_MAX_TOKENS=2048
# Qwen "thinking" mode. off (default) = faster/cheaper, fine for tool routing;
# on = reasoning trace before answering, for complex multi-step asks.
GOVERNANCE_CHAT_THINKING=off
# (Alternative provider: set AZURE_OPENAI_API_KEY / AZURE_OPENAI_ENDPOINT /
#  GOVERNANCE_CHAT_DEPLOYMENT instead of the three GOVERNANCE_CHAT_* vars above.)

# ── LLM admission control (gateway/llm_broker.py) ─────────────────────────────
# Everything -- chat, the workflow copilot, session summaries, workflow AI steps
# -- shares ONE model server with a fixed number of concurrent slots, so the
# broker splits them into an interactive lane (a person is waiting) and a batch
# lane (workflow steps), and queues fairly per user within a lane.
#
# This MUST match the live server's own max_running_requests (for sglang that is
# set by --max-mamba-cache-size, not --mem-fraction-static or --context-length;
# check /get_server_info rather than guessing). Too high and we queue invisibly
# inside the model server where we cannot prioritize; too low and slots idle.
# `MAX_RUNNING_REQUESTS` is accepted as a bare alias.
# GOVERNANCE_LLM_MAX_RUNNING_REQUESTS=3
# Batch work is capped at capacity-2 (floor 1) automatically, so at capacity 3
# a person can always get 2 slots no matter what workflows are running.
#
# How many callers may WAIT before we reject with 503 assistant_busy rather than
# grow an unbounded backlog, and how long each lane waits for a slot.
# GOVERNANCE_LLM_MAX_QUEUE=32
# GOVERNANCE_LLM_INTERACTIVE_QUEUE_TIMEOUT_SEC=45
# GOVERNANCE_LLM_BATCH_QUEUE_TIMEOUT_SEC=300
#
# Per-request HTTP timeouts for the model call itself. `read` is the gap BETWEEN
# received bytes, so it bounds a stalled stream without capping a long-but-
# healthy generation (the SDK's own 600s default is far too long for a path a
# person is watching).
# GOVERNANCE_LLM_CONNECT_TIMEOUT_SEC=10
# GOVERNANCE_LLM_READ_TIMEOUT_SEC=180
# GOVERNANCE_LLM_WRITE_TIMEOUT_SEC=30
# GOVERNANCE_LLM_POOL_TIMEOUT_SEC=10
#
# Ask the server to report token usage on STREAMED responses too, so the prefix-
# cache hit rate is measurable on the chat path. Off by default: `stream_options`
# is an OpenAI-compatible extra that a self-hosted server may reject outright,
# and a rejected parameter would break chat to gain a metric. Turn on once
# confirmed against the live server. The non-streaming path reports it either way.
# GOVERNANCE_LLM_STREAM_USAGE=off
#
# Live view: GET /admin/llm-lanes (admin only) -- lane occupancy, queue depth
# per user, average/max wait, callers rejected as busy, and under `promptCache`
# the prefix-cache signals: `distinctPrefixes` (our own canary -- should go flat,
# not climb with traffic) and `cacheHitRate` (the server's own reuse figure).

# Backup LLM switch. true (default) -> the local Qwen/Azure OpenAI backend
# above; false -> Claude Sonnet via the GOVERNANCE_ANTHROPIC_* vars below.
# USE_LOCAL_LLM=true
# Claude Sonnet via an Anthropic-compatible endpoint (e.g. Azure AI Foundry's
# Anthropic-compatible route, which looks like
# https://<resource>.services.ai.azure.com/anthropic). Only read when
# USE_LOCAL_LLM=false.
# GOVERNANCE_ANTHROPIC_ENDPOINT=
# GOVERNANCE_ANTHROPIC_API_KEY=
# GOVERNANCE_ANTHROPIC_MODEL=claude-sonnet-4-6

# Knowledge/document Q&A backend -- read-only (no ingest tools; see
# mcp-knowledge/app.py). Its own KNOWLEDGE_RETRIEVAL_BASE_URL (in
# mcp-knowledge/.env.local, not here) points it at AraTestEnvBE's ragAgent to
# search the SAME Azure Blob/AI Search knowledge base; unset it there to use
# mcp-knowledge's small local JSON-file fallback instead.
KNOWLEDGE_MCP_URL=http://localhost:8050/mcp
# Local registry for whatever documents already exist locally (list/delete via
# the dashboard); nothing new gets added through this gateway anymore.
# GOVERNANCE_KNOWLEDGE_STORE_FILE=.governance-state/knowledge.json

# Calendar invite draft + connector queue backend
CALENDAR_MCP_URL=http://localhost:8060/mcp
# GOVERNANCE_CALENDAR_SEND_STORE_FILE=./data/state/calendar-sends.json
# CALENDAR_DELIVERY_PROVIDER=manual   # future: outlook, google, graph
# CALENDAR_MOCK_SEND=false            # true marks approved invites as sent locally

# Reusable report/deck/document/email/calendar/workflow templates
# GOVERNANCE_TEMPLATE_STORE_FILE=./data/state/templates.json

# Read-only code planning backend (opencode planning lane)
CODE_MCP_URL=http://localhost:8070/mcp
CODE_AUTOMATION_REPO_ROOT=C:\projects\AraTest\governence_agent
GOVERNANCE_CODE_PLAN_STORE_FILE=
