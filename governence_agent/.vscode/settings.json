{
  "// note": "Used by the VS Code Azure App Service extension to keep the deploy zip clean.",
  "appService.zipIgnorePattern": [
    ".venv{,/**}",
    "**/__pycache__{,/**}",
    "**/*.pyc",
    "_smoke{,/**}",
    "mcp-minierp-orders{,/**}",
    "mcp-minierp-accounts{,/**}",
    "mcp-minierp-shipments{,/**}",
    "mcp-minierp-finance{,/**}",
    "governance_service{,/**}",
    "**/.env.local",
    "appservice.settings.local.json",
    "minierp.env",
    "**/data{,/**}",
    "**/*.md",
    ".git{,/**}"
  ]
}
