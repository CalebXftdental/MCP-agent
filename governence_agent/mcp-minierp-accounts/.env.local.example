# mcp-minierp-accounts backend -- miniERP (Acumatica) credentials ONLY.
# No governance keys live here; the gateway owns auth/rate/redaction.

# Option A: username/password (a JWT is issued + cached in-process)
MINIERP_USERNAME=
MINIERP_PASSWORD=
# Option B: a pre-issued JWT (skips sign-in)
# MINIERP_TOKEN=

# Optional overrides
# MINIERP_GRAPHQL_URL=https://db-api.frontierdental.com/graphql
# MINIERP_TIMEOUT_SEC=20

# Local listener port (Azure sets PORT/WEBSITES_PORT in prod)
MINIERP_ACCOUNTS_PORT=8023

# Hosts allowed by the MCP transport (comma-separated). In prod set this to the
# Container App's ingress hostname. localhost is always allowed for dev.
MINIERP_ACCOUNTS_ALLOWED_HOSTS=
