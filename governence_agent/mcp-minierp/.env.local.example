# mcp-minierp (consolidated backend) -- miniERP (Acumatica) credentials ONLY.
# No governance keys live here; the gateway owns auth/rate/redaction.

# ── Default account (orders / accounts / shipments domains) ──
# Option A: username/password (a JWT is issued + cached in-process)
MINIERP_USERNAME=
MINIERP_PASSWORD=
# Option B: a pre-issued JWT (skips sign-in)
# MINIERP_TOKEN=

# ── "admin" profile (finance domain) ──
# Finance (AR/AP/GL/PO/Vendor) needs the higher-privilege account. The finance
# domain sends every query under the "admin" credential profile.
MINIERP_ADMIN_USERNAME=
MINIERP_ADMIN_PASSWORD=
# MINIERP_ADMIN_TOKEN=

# Optional overrides
# MINIERP_GRAPHQL_URL=https://db-api.frontierdental.com/graphql
# MINIERP_TIMEOUT_SEC=20

# Which companyId(s) tools resolve against: "CA" (11, default), "US" (2), or
# "ALL" (both). Was hardcoded to "CA" -- set this explicitly rather than relying
# on the default if this deployment should ever serve US orders/customers.
# MINIERP_REGION=CA

# Local listener port (the gateway reaches this on 127.0.0.1; startup.sh uses 8021)
MINIERP_PORT=8021

# Hosts allowed by the MCP transport (comma-separated). localhost is always
# allowed; the gateway calls this backend on 127.0.0.1, so nothing extra needed.
MINIERP_ALLOWED_HOSTS=
