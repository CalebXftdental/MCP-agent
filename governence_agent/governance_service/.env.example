# Copy to .env.local (git-ignored). This service is the ONLY place these
# credentials should ever live -- the chatbot / email bot / any other
# consumer only ever hold their own GOVERNANCE_KEY_* value + GOVERNANCE_SERVICE_URL.

# ── miniERP (Acumatica GraphQL) ────────────────────────────────────────────
MINIERP_USERNAME=
MINIERP_PASSWORD=
# Or, to skip sign-in and use a pre-issued token instead:
# MINIERP_TOKEN=
MINIERP_GRAPHQL_URL=https://db-api.frontierdental.com/graphql
MINIERP_AUTH_URL=https://db-api.frontierdental.com/authentication/sign-in
# MINIERP_TIMEOUT_SEC=20
# Aliases accepted in place of the two URLs above (shared with local_test tooling):
# FD_API=<same as MINIERP_GRAPHQL_URL>
# FD_API_BASE=<base URL that /authentication/sign-in is appended to>

# ── HubSpot ─────────────────────────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
# HUBSPOT_COMPANY_SEARCH_URL=https://api.hubapi.com/crm/objects/2026-03/companies/search
# HUBSPOT_REQUEST_TIMEOUT_S=15

# hubspot/contacts.json and hubspot/phonebook.json are git-ignored (real sales-rep
# names/phones/emails) -- see hubspot/*.example.json for the shape. Populate the
# real files locally, OR set the blob vars below to serve them from Blob storage
# instead (recommended for deployed environments):
# CONTACTS_BLOB_CONNECTION_STRING=
# CONTACTS_BLOB_CONTAINER=
# CONTACTS_BLOB_NAME=contacts.json
# CONTACTS_BLOB_TIMEOUT_S=15
# PHONEBOOK_BLOB_NAME=phonebook.json

# ── Layer 1: Governance Edge (edge.py) ─────────────────────────────────────
# One API key PER CONSUMER -- the key itself is the consumer's verified
# identity (not a self-reported header). Add one line per real caller:
GOVERNANCE_KEY_CHATBOT=
GOVERNANCE_RATE_LIMIT_CHATBOT=1000
# GOVERNANCE_KEY_EMAIL_BOT=
# GOVERNANCE_RATE_LIMIT_EMAIL_BOT=500

# Fallback used only if no GOVERNANCE_KEY_* matches -- a single key shared by
# every caller, logged under consumer "legacy". Retire this once every real
# consumer has its own GOVERNANCE_KEY_* above.
GOVERNANCE_SHARED_SECRET=

# Default quota (calls/hour) for any consumer without its own
# GOVERNANCE_RATE_LIMIT_<NAME>, including the "legacy" shared-secret consumer.
GOVERNANCE_DEFAULT_RATE_LIMIT_PER_HOUR=100

# Optional: comma-separated IPs/CIDRs allowed to reach this service at all,
# checked before the API key. Leave unset to allow any IP through to the key
# check -- this is meant as defense-in-depth on top of VNet/Private Endpoint
# isolation, not a substitute for it.
# GOVERNANCE_IP_ALLOWLIST=10.0.0.0/24,10.0.1.5

# Max request body size in bytes (rejects anything larger before it reaches a
# tool). MCP tool-call payloads are small JSON; the default is generous.
GOVERNANCE_MAX_BODY_BYTES=65536

# ── Server ──────────────────────────────────────────────────────────────────
GOVERNANCE_PORT=8020

# REQUIRED on any deployed (non-localhost) environment -- the MCP SDK's
# Streamable HTTP transport rejects requests whose Host header isn't on this
# list (DNS-rebinding protection), and defaults to allowing nothing but
# localhost. Without this set, every request is silently rejected at the
# transport layer before EdgeMiddleware or any tool ever runs -- it won't
# even show up in this service's own audit dashboard. Comma-separated bare
# hostnames (no port, no scheme) -- app.py adds both the bare and ":*"
# wildcard-port forms automatically:
GOVERNANCE_ALLOWED_HOSTS=governence-agent-dycufrgya2ewash8.canadaeast-01.azurewebsites.net

# ── Monitoring ────────────────────────────────────────────────────────────
# Open http://<host>:8020/dashboard and paste in any GOVERNANCE_KEY_* value to
# watch live calls, denials, rate-limit usage, unauthorized attempts, and
# active session scope. No extra config needed.
