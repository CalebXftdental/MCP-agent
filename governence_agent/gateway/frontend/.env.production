# ─── Applied on `npm run build` (mode=production), layered over .env ──────────

# The gateway serves the built bundle itself, so a bare path keeps the browser on
# its own origin. This is the intended deployment.
VITE_API_BASE_URL=/backend

# If the SPA is ever hosted APART from the gateway (CDN, its own App Service),
# make this absolute and keep the /backend suffix. Note it cannot work on its own
# — it needs two matching server-side changes, because the cookie currently
# forbids cross-site use by design:
#   1. CORS on the gateway: allow this origin + Access-Control-Allow-Credentials
#   2. relax the session cookie to SameSite=None; Secure (gateway/app.py:910)
# Prefer keeping them same-origin and avoiding both.
# VITE_API_BASE_URL=https://gateway.example.com/backend
